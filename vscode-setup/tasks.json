{
  "version": "2.0.0",
  "tasks": [
    { "label": "npm install", "type": "npm", "script": "install", "problemMatcher": [] },
    {
      "label": "npm run dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^x" },
        "background": { "activeBegins": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
